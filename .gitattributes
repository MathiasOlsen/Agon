# Everything is stored with LF in the repository, whatever the working copy uses.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary

# Lockfiles are generated; keep them out of diffs and language stats.
pnpm-lock.yaml -diff linguist-generated
